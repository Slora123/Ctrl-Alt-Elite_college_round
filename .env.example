CG_ENV=dev
CG_LOG_LEVEL=INFO
CG_DATABASE_URL=postgresql+psycopg://crisisgrid:crisisgrid@localhost:5432/crisisgrid
CG_REDIS_URL=redis://localhost:6379/0
CG_S3_ENDPOINT=http://localhost:9000
CG_S3_BUCKET=crisisgrid

# ---- LLM (copy this file to .env, fill in what you use; .env is gitignored). run_all.py loads .env, then .cg/env.
# Prefer a non-reasoning instruct model: reasoning models (gpt-oss, qwen3 thinking) can spend the whole budget and return nothing.
CG_LLM_CHAIN=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
CG_LLM_MAX_TOKENS=4096
CG_GENERATE_NOTEBOOKS=1
NVIDIA_NIM_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION_NAME=
# GITHUB_TOKEN=
